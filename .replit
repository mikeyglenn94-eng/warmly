modules = ["nodejs-24", "postgresql-16"]
run = "pnpm start"
entrypoint = "artifacts/api-server/src/index.ts"

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

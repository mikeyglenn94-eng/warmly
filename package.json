{
  "name": "warmly",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"if (!String(process.env.npm_config_user_agent || '').includes('pnpm')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm --filter @warmly/api-server run build",
    "start": "pnpm --filter @warmly/api-server start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
